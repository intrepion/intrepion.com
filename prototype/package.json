{
  "name": "intrepion-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1 --port 4321",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 4321",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test:unit": "node src/lib/model.test.ts",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@playwright/test": "^1.0.0",
    "@types/node": "^26.0.0",
    "typescript": "^6.0.0"
  }
}
