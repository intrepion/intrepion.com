---
import "../styles/app.css";
const apiOrigin = import.meta.env.PUBLIC_API_ORIGIN ?? "http://127.0.0.1:8788";
const url = new URL(apiOrigin);
if (
  url.origin !== apiOrigin ||
  (!["https:"].includes(url.protocol) && url.hostname !== "127.0.0.1")
)
  throw new Error(
    "PUBLIC_API_ORIGIN must be an exact HTTPS origin or local 127.0.0.1 origin.",
  );
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="color-scheme" content="light" /><meta
      name="robots"
      content="noindex,nofollow"
    /><title>Tasks · intrepion</title></head
  >
  <body>
    <main id="app" data-api-origin={apiOrigin}>
      <header>
        <div class="brand">
          <span aria-hidden="true" class="brand-mark">✓</span>intrepion
        </div><span class="muted small">Personal list</span>
      </header>
      <section id="status-view" class="center" aria-live="polite">
        <span class="spinner" aria-hidden="true"></span><h1
          tabindex="-1"
          id="status-title"
        >
          Opening your list
        </h1><p id="status-description">
          The server may take a minute to wake up.
        </p><div id="google-button"></div><button
          id="development-login"
          class="primary"
          hidden>Sign in as development owner</button
        ><button id="retry-load" hidden>Try again</button>
      </section>
      <section id="list-view" class="content" hidden>
        <div class="heading">
          <div>
            <h1 tabindex="-1">Tasks</h1><p class="muted" id="task-count"></p>
          </div><button id="new-task" class="primary"
            ><span aria-hidden="true">＋</span> New task</button
          >
        </div>
        <div id="list-error" class="error" role="alert" hidden>
          <p></p><button id="retry-action">Retry action</button><button
            id="reload-list">Reload list</button
          >
        </div>
        <div id="empty" class="center" hidden>
          <span class="empty-mark" aria-hidden="true">✓</span><h2>
            A little space for what matters
          </h2><p>Add your first task. Keep it simple.</p><button
            id="first-task"
            class="primary">Create a task</button
          >
        </div>
        <div id="open-tasks"></div><h2
          id="completed-heading"
          class="completed-heading"
        >
          Completed <span id="completed-count"></span>
        </h2><div id="completed-tasks"></div>
      </section>
      <section id="editor-view" class="content" hidden>
        <form id="task-form" class="editor" novalidate>
          <button type="button" id="back-to-list" class="quiet back"
            >← Back to tasks</button
          ><h1 id="editor-heading" tabindex="-1">New task</h1><p
            class="muted description"
          >
            A clear title is enough. Add notes if they help.
          </p>
          <div id="save-error" class="error" role="alert" hidden>
            <p></p><button type="button" id="editor-reload">Reload list</button>
          </div>
          <div class="field-label">
            <label for="title">Title</label><span
              id="title-count"
              class="muted small">0 / 200</span
            >
          </div>
          <input
            id="title"
            name="title"
            autocomplete="off"
            placeholder="What would you like to do?"
            aria-describedby="title-error title-count"
          /><p id="title-error" class="field-error"></p>
          <div class="field-label">
            <label for="notes"
              >Notes <span class="muted small">(optional)</span></label
            ><span id="notes-count" class="muted small">0 / 10,000</span>
          </div>
          <textarea
            id="notes"
            name="notes"
            rows="5"
            aria-describedby="notes-error notes-count"></textarea><p
            id="notes-error"
            class="field-error"
          >
          </p><p class="muted small">
            Plain text. Only you can access these tasks.
          </p>
          <div class="form-actions">
            <button type="button" id="cancel-edit">Cancel</button><button
              type="submit"
              class="primary"
              id="save-task">Save task</button
            >
          </div>
        </form>
      </section>
      <footer id="account" hidden>
        <span class="muted small">Owner account</span><button
          class="quiet"
          id="sign-out">Sign out</button
        >
      </footer>
      <noscript
        ><p>
          This task application needs JavaScript. Your tasks remain on the
          server.
        </p></noscript
      >
    </main>
    <p id="announcement" class="sr-only" role="status" aria-live="polite"></p>
    <dialog
      id="confirm"
      aria-labelledby="confirm-title"
      aria-describedby="confirm-description"
    >
      <h2 id="confirm-title"></h2><p id="confirm-description"></p><p
        id="confirm-task"
        class="task-reference"
        hidden
      >
      </p><div class="form-actions">
        <button id="confirm-cancel">Cancel</button><button
          id="confirm-accept"
          class="danger">Delete task</button
        >
      </div>
    </dialog>
    <script>
      import "../scripts/app";
    </script>
  </body>
</html>
