# Production environment variables. Never commit actual credentials.
APP_ENV=production
WEB_ORIGIN=https://intrepion.com
PORT=8788
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
D1_DATABASE_ID=replace-with-database-uuid
D1_API_TOKEN=replace-with-account-d1-edit-token
GOOGLE_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com
GOOGLE_OWNER_SUB=replace-with-stable-google-sub
# MVP 2 permanent erasure: separate writeFiles-only B2 key, scoped to
# erasures/<D1_DATABASE_ID>/ in the existing bucket. All three or none.
# Missing configuration safely disables permanent erasure.
# ERASURE_B2_KEY_ID=replace-with-scoped-ledger-key-id
# ERASURE_B2_APPLICATION_KEY=replace-with-scoped-ledger-key
# ERASURE_B2_BUCKET_ID=replace-with-existing-backup-bucket-id

# Optional private MVP 3 operator services; configure at the approved launch gate.
# Two different 32-byte random secrets encoded as 64 hex characters.
# Never use PUBLIC_ variables or put actual credentials in this example file.
# PILOT_OPERATOR_TOKEN=
# HOUSEHOLD_MAINTENANCE_TOKEN=

# Strict true/false; omitted defaults to false. Apply with a new deployment.
# true blocks customer/auth/retention writes; private operator bootstrap remains.
# CUSTOMER_WRITES_FROZEN=false

# MVP 3.1: separate 64-hex secrets. Do not enable sending until the release gates.
# INVITATION_SIGNING_KEY=
# EMAIL_OPERATIONS_TOKEN=
# Configure these seven SES settings together; all absent keeps delivery disabled.
# SES_REGION=
# SES_FROM_ADDRESS=
# SES_REPLY_TO_ADDRESS=
# SES_CONFIGURATION_SET=
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SES_FEEDBACK_TOPIC_ARN=
# Optional for temporary AWS credentials:
# SES_SESSION_TOKEN=
# See docs/mvp-3-1-release.md for policy activation, feedback and recovery.
